# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Meta Graph API (Instagram & Facebook) — needed for the one-click "Connect with Facebook"
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Must match "Valid OAuth Redirect URIs" in the Meta dashboard exactly
META_REDIRECT_URI=http://localhost:5000/auth/facebook/callback

# Optional: only for headless setups. Normal use = press "Connect with Facebook" in the dashboard.
# META_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=
# FACEBOOK_PAGE_ID=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=your_tiktok_user_access_token
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Scheduling Delays & Daily Limits
DAILY_LIMIT_INSTA=3
DAILY_LIMIT_TIKTOK=3
MIN_DELAY_MINUTES=120
MAX_DELAY_MINUTES=240
